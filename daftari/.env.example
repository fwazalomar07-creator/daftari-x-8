# ملف الإعدادات السرية — لا تشاركه ولا ترفعه على GitHub (موجود في .gitignore)

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# ---- Gemini (مساعد شركة العمر) ----
# اكتب مفتاحك هنا (من https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# النموذج الافتراضي: الأسرع والأرخص. لدقة أعلى جرّب: gemini-3.6-flash
GEMINI_MODEL=gemini-3.5-flash-lite
# مستوى التفكير: minimal | low | medium | high  (low = أقل استهلاكاً للحصة؛ high = أقصى قدرة لكنه يستهلك رموزاً أكثر)
GEMINI_THINKING=low
# أقصى طول للرد بالـ tokens (النموذج يدعم حتى 65536)
GEMINI_MAX_OUTPUT_TOKENS=32768
# بحث جوجل المدمج في Gemini (1 = مفعّل). الأداة google_search الخاصة بالبرنامج تكفي عادةً، وتعطيله يوفّر حصة.
GEMINI_GOOGLE_SEARCH=0

# ---- مزوّدون إضافيون (اختياري — أو أضفهم من الإعدادات داخل البرنامج) ----
# يكفي مفتاح واحد ليظهر المزوّد. عند انتهاء حصة الأول ينتقل البرنامج للتالي تلقائياً.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# تغيير النموذج لمزوّد:  GROQ_MODEL=llama-3.3-70b-versatile   |  تغيير الرابط:  OPENAI_BASE_URL=...
# ترتيب الأولوية (الأول أساسي):
# LLM_ORDER=gemini,groq,openai
